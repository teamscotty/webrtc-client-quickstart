# Copy this to .env and fill it in. Never commit the real .env — it holds
# a platform API key that can do anything in your organization.

API_KEY=
CHANNEL_DEFINITION_ID=

# Defaults to prod if left unset. API_KEY and CHANNEL_DEFINITION_ID must
# belong to whichever environment this points at — a staging channel
# definition 404s against prod, and vice versa.
# PLATFORM_URL=https://api.scotty-ai.com
# PLATFORM_URL=https://api.scotty-ai-dev.com  # staging
